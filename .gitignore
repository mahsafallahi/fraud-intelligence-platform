# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.venv-dbt/
venv/

# Data (raw/large files shouldn't be committed)
# Ignore everything inside each layer (including partition subfolders), keep .gitkeep
data/raw/
data/landing/
data/bronze/*
data/silver/*
data/gold/*
# Serving snapshot for the API (built from Gold, holds home coordinates): never committed
data/serving/*
!data/*/.gitkeep

# Environment
.env

# Airflow
airflow.db
airflow-webserver.pid
logs/

# dbt (build output, packages, logs, user id file; the DuckDB file is in data/gold/)
src/dbt/target/
src/dbt/dbt_packages/
src/dbt/logs/
src/dbt/.user.yml

# MLflow (experiment runs and saved models are reproducible outputs, not code)
mlruns/
mlartifacts/
mlflow.db

# IDE
.vscode/
.idea/

# OS
.DS_Store
# Phase 7 RAG: downloaded documents, built index and run outputs (reproducible; the manifest is committed)
data/rag/raw/
data/rag/index/
data/rag/runs/
